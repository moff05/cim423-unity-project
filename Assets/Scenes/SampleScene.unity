  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrewLog
  logId: okafor
  header: DR. OKAFOR, PHYSICIST. DAY 179
  pages:
  - '"It isn''t emitting. It''s replying. Every pulse we send comes back changed,
    with our own voices folded into it. Words we haven''t said yet."'
  - '"It responds to attention. The more of us in the room, the stronger it gets.
    He wants all five."'
  screenRenderer: {fileID: 2120318253}
