  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrewLog
  logId: reyes
  header: REYES, ENGINEER. DAY 180
  pages:
  - '"He had me wire the main bus straight into the lab. So I pulled the reactor
    cell and hid it on the rack with the dead ones. No cell, no test."'
  - '"If you''re reading this and the lights are on, somebody put it back. Pull the
    breaker. Seal the lab. Don''t let it finish."'
  screenRenderer: {fileID: 1572797187}
