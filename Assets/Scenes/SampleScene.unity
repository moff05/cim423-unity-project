  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrewLog
  logId: halvorsen
  header: DIRECTOR HALVORSEN. DAY 181
  pages:
  - '"Reyes tried to stop it. It didn''t matter. It asked for all of us and we came.
    We are not gone. We are kept."'
  - '"If it is quiet when you find this, it is only waiting for someone to listen.
    It will ask for you by name."'
  screenRenderer: {fileID: 1547379626}
